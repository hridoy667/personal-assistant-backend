<!-- src/mail/templates/new-complain.hbs -->
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #fda4af; padding: 20px; border-radius: 12px;">
  <h2 style="color: #be123c; border-bottom: 2px solid #fecdd3; padding-bottom: 10px;">🚨 New Complain Registered!</h2>
  
  <p>Hello Admin,</p>
  <p>A user has submitted a new complaint. Below are the complainant's details and description:</p>

  <!-- Complainant Details -->
  <div style="background: #fff1f2; padding: 15px; border-radius: 8px; border: 1px solid #ffe4e6; margin-bottom: 20px;">
    <h3 style="margin-top: 0; color: #9f1239;">Complainant Info</h3>
    <p style="margin: 4px 0;"><strong>Name:</strong> {{complainantName}}</p>
    <p style="margin: 4px 0;"><strong>Email:</strong> {{complainantEmail}}</p>
    <p style="margin: 4px 0;"><strong>Phone:</strong> {{complainantPhone}}</p>
  </div>

  <!-- Complain Details -->
  <h3 style="color: #27272a;">Complain Description</h3>
  <div style="background: #f4f4f5; padding: 15px; border-radius: 8px; border: 1px solid #e4e4e7; white-space: pre-line; line-height: 1.6;">
    {{complainDescription}}
  </div>

  <p style="margin-top: 30px; font-size: 12px; color: #71717a;">This is an automated notification from Organic Haat.</p>
</div>