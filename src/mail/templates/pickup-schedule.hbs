<!-- src/mail/templates/pickup-schedule.hbs -->
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #e4e4e7; padding: 20px; border-radius: 12px;">
  <h2 style="color: #15803d; border-bottom: 2px solid #bbf7d0; padding-bottom: 10px;">New Pickup Scheduled!</h2>
  
  <p>Hello Admin,</p>
  <p>A farmer has scheduled a pickup for an order. Here are the details:</p>

  <!-- Order Info -->
  <h3 style="color: #27272a;">Order Details</h3>
  <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
    <tr style="background: #f4f4f5;">
      <td style="padding: 8px; font-weight: bold; border: 1px solid #e4e4e7;">Order ID</td>
      <td style="padding: 8px; border: 1px solid #e4e4e7;">{{orderId}}</td>
    </tr>
    <tr>
      <td style="padding: 8px; font-weight: bold; border: 1px solid #e4e4e7;">Total Price</td>
      <td style="padding: 8px; border: 1px solid #e4e4e7;">BDT {{totalPrice}}</td>
    </tr>
    <tr style="background: #f4f4f5;">
      <td style="padding: 8px; font-weight: bold; border: 1px solid #e4e4e7;">Delivery Address</td>
      <td style="padding: 8px; border: 1px solid #e4e4e7;">{{deliveryAddress}}</td>
    </tr>
  </table>

  <!-- Customer & Farmer Info -->
  <div style="display: grid; grid-template-cols: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
    <div style="background: #f0fdf4; padding: 15px; border-radius: 8px; border: 1px solid #bbf7d0;">
      <h4 style="margin-top: 0; color: #166534;">Customer Details</h4>
      <p style="margin: 4px 0;"><strong>Name:</strong> {{customerName}}</p>
      <p style="margin: 4px 0;"><strong>Email:</strong> {{customerEmail}}</p>
      <p style="margin: 4px 0;"><strong>Phone:</strong> {{customerPhone}}</p>
    </div>
    
    <div style="background: #fefcf0; padding: 15px; border-radius: 8px; border: 1px solid #fef08a;">
      <h4 style="margin-top: 0; color: #854d0e;">Farmer Details</h4>
      <p style="margin: 4px 0;"><strong>Name:</strong> {{farmerName}}</p>
      <p style="margin: 4px 0;"><strong>Email:</strong> {{farmerEmail}}</p>
      <p style="margin: 4px 0;"><strong>Phone:</strong> {{farmerPhone}}</p>
    </div>
  </div>

  <!-- Ordered Items -->
  <h3 style="color: #27272a;">Product Items</h3>
  <table style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead>
      <tr style="background: #e4e4e7;">
        <th style="padding: 8px; border: 1px solid #d4d4d8;">Product</th>
        <th style="padding: 8px; border: 1px solid #d4d4d8;">Qty</th>
        <th style="padding: 8px; border: 1px solid #d4d4d8;">Price</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td style="padding: 8px; border: 1px solid #e4e4e7;">{{this.productName}}</td>
        <td style="padding: 8px; border: 1px solid #e4e4e7;">{{this.quantity}}</td>
        <td style="padding: 8px; border: 1px solid #e4e4e7;">BDT {{this.price}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <p style="margin-top: 30px; font-size: 12px; color: #71717a;">This is an automated notification from Organic Haat.</p>
</div>