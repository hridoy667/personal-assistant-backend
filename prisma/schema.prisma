generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
  url        = env("DATABASE_URL")
}

//////////////////////
// EXISTING ENUMS
//////////////////////

enum UserRole {
  USER
  ADMIN
}

enum complainStatus {
  PENDING
  PROCESSING
  SOLVED
}

enum PolicyType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
}

//////////////////////
// PRODUCTIVITY ENUMS
//////////////////////

enum TaskPriority {
  P1_URGENT
  P2_HIGH
  P3_MEDIUM
  P4_LOW
}

enum MoodLevel {
  LOW_ENERGY
  DEPRESSED
  ANXIOUS
  BALANCED
  HIGH_ENERGY
}

enum EnergyRequirement {
  LOW
  MEDIUM
  HIGH
}

enum HabitType {
  BINARY
  QUANTITATIVE
}

enum RoutineType {
  MORNING
  AFTERNOON
  EVENING
  CUSTOM
}

enum AppCategory {
  PRODUCTIVE
  NEUTRAL
  DISTRACTING
}

enum BriefingType {
  MORNING
  EVENING
  WEEKLY
}

enum DeviceOs {
  ANDROID
  IOS
  WEB
}

enum ActivityType {
  WALKING
  RUNNING
  EXERCISING
  WORKING
  DEEP_WORK
  MEETING
  EATING
  RESTING
  COMMUTING
  SOCIALIZING
  CHORES
  TIMEKILL
  ENTERTAINMENT
  OTHER
}
//////////////////////
// USER MODEL
//////////////////////

model User {
  id                            String     @id @default(cuid())
  email                         String?    @unique
  phone                         String?    @unique
  name                          String
  userName                      String?    @unique
  password                      String?
  avatarUrl                     String?
  bio                           String?
  dateOfBirth                   DateTime?
  gender                        Gender?

  // Location & Timezone (Automated)
  timezone                      String     @default("Asia/Dhaka")
  district                      String?
  upazila                       String?
  latitude                      Float?
  longitude                     Float?

  // Physical Health & Metrics
  height                        Float?     // in meters
  weight                        Float?     // in kg
  activityLevel                 ActivityLevel? @default(SEDENTARY)

  // Modular Feature Preferences (Optional Modules)
  enableIslamicFeatures         Boolean    @default(false)
  enableMailAssistance          Boolean    @default(false)
  enableFinanceTracker          Boolean    @default(true)
  enableHealthTracking          Boolean    @default(true)
  enableScreenTimeTracking      Boolean    @default(false)
  enableAiBriefings             Boolean    @default(true)

  // Profile & App Status
  dailyTargetFocus              String?
  isProfileComplete             Boolean    @default(false)
  type                          UserRole   @default(USER)
  status                        Int?       @default(1)
  isVerified                    Boolean    @default(false)

  // Notification Preferences
  isNotificationOn              Boolean    @default(true)
  securityAlert                 Boolean    @default(false)
  emailNotification             Boolean    @default(false)
  is_agreed_to_terms_and_policy Boolean?   @default(false)
  firebaseToken                 String[]

  // OAuth Integrations (Populated only if enableMailAssistance is true)
  gmailRefreshToken             String?
  gmailConnectedAt              DateTime?

  createdAt                     DateTime   @default(now())
  updatedAt                     DateTime   @updatedAt

  // Relations
  verificationTokens            verificationToken[]
  notification                  Notification[]
  complain                      Complain[]

  // Productivity & Tracking Relations
  tasks                         Task[]
  habits                        Habit[]
  routines                      Routine[]
  moodLogs                      MoodLog[]
  transactions                  Transaction[]
  budgets                       Budget[]
  savingsGoals                  SavingsGoal[]
  healthLogs                    HealthLog[]
  screenTimeLogs                ScreenTimeLog[]
  appUsages                     AppUsage[]
  syncedEmails                  SyncedEmail[]
  journals                      JournalEntry[]
  memories                      MemoryVault[]
  aiBriefings                   AiBriefing[]
  userSkills                    Skill[]
  activity                      ActivityLog[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

model districts {
  id        Int    @id
  name      String @unique
  latitude  Float
  longitude Float

  @@map("districts")
}

//////////////////////
// EXISTING MODELS
//////////////////////

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verificationToken {
  id        String   @id @default(uuid())
  userId    String?
  email     String?  @unique
  token     String
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Complain {
  id        String         @id @default(cuid())
  userId    String
  ticket    String         @unique
  title     String
  body      String
  category  String
  solution  String?
  status    complainStatus @default(PENDING)
  isSeen    Boolean        @default(false)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ActivityLog {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ActivityType @default(WORKING)
  durationMin Int?         // Duration in minutes (e.g., 45)
  note        String?      @db.Text
  loggedAt    DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@map("activity_logs")
}

model Legals {
  id          String     @id @default(uuid())
  type        PolicyType @default(PRIVACY_POLICY)
  version     String
  content     String     @db.Text
  isActive    Boolean    @default(false)
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([type, version])
  @@map("privacy_policies")
}

///////////////////////////////////////////////////
// NEW PRODUCTIVITY & GROWTH MODULES
///////////////////////////////////////////////////

model Task {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?            @db.Text
  priority         TaskPriority       @default(P3_MEDIUM)
  energyRequired   EnergyRequirement  @default(MEDIUM)
  dueDate          DateTime?
  estimatedMinutes Int?
  isTopPriority    Boolean            @default(false)
  isCompleted      Boolean            @default(false)
  completedAt      DateTime?
  recurrenceRule   String?            // e.g. "FREQ=DAILY", "REL=FAJR_AFTER"
  category         String?
  tags             String[]
  
  // Relations
  parentId         String?
  parentTask       Task?              @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks         Task[]             @relation("TaskSubtasks")
  syncedEmailId    String?            @unique
  syncedEmail      SyncedEmail?       @relation(fields: [syncedEmailId], references: [id])

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("tasks")
}

// 1. HABITS & SKILLS
model Habit {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  type           HabitType   @default(BINARY)
  targetValue    Float       @default(1) // e.g. 1 time, or 2500 ml
  unit           String?     // e.g. "ml", "pages", "mins"
  currentStreak  Int         @default(0)
  longestStreak  Int         @default(0)
  streakSavers   Int         @default(1) // Monthly protection count
  logs           HabitLog[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("habits")
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  value     Float    @default(1)
  loggedAt  DateTime @default(now())

  @@map("habit_logs")
}

model Skill {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String   // e.g. "Master React Native"
  targetHours    Float
  loggedHours    Float    @default(0)
  level          String?  // e.g. "Beginner", "Intermediate"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("skills")
}

// 3. ROUTINES
model Routine {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      RoutineType @default(MORNING)
  steps     Json        // Sequence of steps with duration and triggers
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@map("routines")
}

// 5. FINANCE MANAGEMENT
model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  category    String
  isExpense   Boolean  @default(true)
  description String?
  isRecurring Boolean  @default(false)
  transactedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("transactions")
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  limit     Float
  month     Int      // 1-12
  year      Int
  createdAt DateTime @default(now())
  @@unique([userId, category, month, year])
  @@map("budgets")
}

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Float
  currentAmount Float    @default(0)
  targetDate    DateTime?
  createdAt     DateTime @default(now())

  @@map("savings_goals")
}

// 6. HEALTH & WELLBEING
model MoodLog {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood           MoodLevel  @default(BALANCED)
  energyScore    Int?        // 1 to 5 scale
  contextTags    String[]    // e.g. ["WORK", "MEETING", "CAFFEINE"]
  symptoms       String[]    // e.g. ["HEADACHE", "EYE_STRAIN"]
  note           String?     @db.Text
  loggedAt       DateTime    @default(now()) // Essential for hourly mapping

  createdAt      DateTime    @default(now())

  @@map("mood_logs")
}

model HealthLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sleepHours     Float?
  waterIntakeMl  Float?
  date           DateTime @db.Date

  @@unique([userId, date])
  @@map("health_logs")
}

// 7. ANDROID SCREEN TIME
model ScreenTimeLog {
  id                  String   @id @default(uuid())
  userId              String
  date                DateTime @db.Date
  totalScreenTimeMins Int
  productivityScore   Float?
  deviceOs            DeviceOs @default(ANDROID)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model AppUsage {
  id            String      @id @default(uuid())
  userId        String
  packageName   String?     // Nullable for iOS (Apple masks package names/bundle IDs)
  appName       String?     // Nullable for iOS (Or category name like "Social Networking")
  category      AppCategory @default(NEUTRAL)
  timeSpentMins Int
  date          DateTime    @db.Date
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 8. GMAIL INTEGRATION
model SyncedEmail {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId  String   @unique
  sender          String
  subject         String
  snippet         String?
  isActionRequired Boolean @default(false)
  task            Task?
  receivedAt      DateTime

  @@map("synced_emails")
}

// 9. JOURNAL
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String?   @db.Text
  audioUrl  String?
  mood      MoodLevel?
  createdAt DateTime @default(now())

  @@map("journal_entries")
}

// 11. PERSONAL KNOWLEDGE & MEMORY (RAG ENABLED)
model MemoryVault {
  id        String                      @id @default(cuid())
  userId    String
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String?                     // e.g. "Notes", "Key Dates", "Ideas"
  content   String                      @db.Text
  embedding Unsupported("vector(1536)")? // Set vector dimensions to match your embedding model (e.g. 1536 for OpenAI / 768 for Nomic)
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt

  @@map("memory_vault")
}

// 12. AI DAILY INTELLIGENCE
model AiBriefing {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      BriefingType @default(MORNING)
  content   Json         // Structured AI briefing outputs (Weather, Priorities, Financial recap, Insights)
  createdAt DateTime     @default(now())

  @@map("ai_briefings")
}